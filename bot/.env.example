# Copy to bot/.env on the target machine and fill in. Never commit a filled copy.

# --- Polyester testnet credentials ---
POLYESTER_SMART_ACCOUNT=
POLYESTER_PRIVATE_KEY=
POLYESTER_API_KEY_ID=
POLYESTER_ED25519_SEED=
POLYESTER_ACCOUNT_ID=

# --- Alert channels (all optional, alerts always hit the journal) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Tuning ---
# Fees are read from the exchange every 30 min (maker/taker per pair); the gap
# floor follows them. An explicit GAP_MIN_PCT pins it instead.
#GAP_MARGIN_PCT=0.01
#GAP_MIN_PCT=0.11
#FEES_REFRESH_SECONDS=1800
DEPTH_MIN_USD=50
SCAN_SECONDS=10
POLL_SECONDS=2
PERSIST_SECONDS=60
BETTER_ASKS_LIMIT=1
BETTER_BIDS_LIMIT=1
BUY_TIMEOUT_SECONDS=180
BOT_MAX_INVENTORY=0.005

# --- Sandbox freeze detection ---
# A paused sandbox stops the guest clock: the wall clock jumps, the monotonic
# clock does not. FREEZE_SECONDS = how big that skew must be, STALL_SECONDS =
# how long the loop may be stuck before we call it a pause.
FREEZE_SECONDS=300
STALL_SECONDS=900

# --- Volume fallback mode ---
#TP_TRIGGER_PCT=0    # server-side TP sells the whole position and reserves it; the bot cannot also sell. 0 = never arm
FALLBACK_SYMBOL=
FALLBACK_MIN_GAP_PCT=0.05
FALLBACK_DEPTH_MIN_USD=1000
FALLBACK_COOLDOWN=60
FALLBACK_PENNY=0
# Saturation ladder: after N consecutive fallback buy timeouts, penny the bid
# (SAT_PENNY_AFTER) with a shorter timeout; after M, buy at the ask (taker fee).
SAT_PENNY_AFTER=2
SAT_TAKER_AFTER=4
FALLBACK_BUY_TIMEOUT=60


